APP_NAME=Laravel
#APP_NAME=FleetTrack
#APP_NAME=VeMS
#APP_NAME=GatePass
#APP_NAME=ViMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stop-picker map (resources/js/components/MapStopPicker.tsx) — bounding box +
# zoom limits that keep the map fixed to one region, plus the country code
# used to restrict the address search. Change these to fix a different
# region; defaults below match the current Bangladesh setup.
#
# VITE_MAP_PROVIDER: "osm" (default) uses Leaflet + OpenStreetMap tiles and
# Nominatim search — completely free, no key needed. "google" switches to
# the Google Maps JavaScript API + Places search, which requires a Google
# Cloud project with billing enabled and an API key below (Maps JavaScript
# API + Places API must both be enabled for that key). If VITE_MAP_PROVIDER
# is "google" but no key is set, the app falls back to the free OSM map.
VITE_MAP_PROVIDER=osm
VITE_GOOGLE_MAPS_API_KEY=

VITE_MAP_COUNTRY_CODE=bd
VITE_MAP_DEFAULT_LAT=23.8103
VITE_MAP_DEFAULT_LNG=90.4125
VITE_MAP_DEFAULT_ZOOM=10
VITE_MAP_MIN_ZOOM=6
VITE_MAP_BOUNDS_SOUTH=20.3
VITE_MAP_BOUNDS_WEST=87.8
VITE_MAP_BOUNDS_NORTH=26.9
VITE_MAP_BOUNDS_EAST=92.9

# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT="VEMS-Attendance/1.0 (your-real-contact@example.com)"
